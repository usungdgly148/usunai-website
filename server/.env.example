# 阿里云短信（Dysmsapi）配置 —— 复制本文件为 .env 并填入真实值即可启用真实验证码
# 四项都填齐后，后端自动从「演示模式」切换为「真实短信模式」；任意一项缺失则仍走演示模式（返回验证码）。
# 注意：.env 含密钥，请勿提交到代码仓库。

# 阿里云 AccessKey（建议用 RAM 子账号，仅授予短信发送权限）
ALIYUN_SMS_ACCESS_KEY_ID=你的AccessKeyId
ALIYUN_SMS_ACCESS_KEY_SECRET=你的AccessKeySecret

# 短信签名（在阿里云「短信服务」控制台申请的、已审核通过的签名名称）
ALIYUN_SMS_SIGN_NAME=你的签名

# 短信模板 CODE（在阿里云「短信服务」控制台申请的、已审核通过的模板，模板变量须包含 ${code}）
ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxxxx

# 以下两项一般无需修改
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_REGION_ID=cn-hangzhou
