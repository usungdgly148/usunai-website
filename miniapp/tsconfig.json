{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": false,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["@tarojs/taro", "@types/webpack-env"],
    "paths": {
      "@/tdesign/*": ["./node_modules/tdesign-miniprogram/miniprogram_dist/*"],
      "tdesign-miniprogram/*": ["./node_modules/tdesign-miniprogram/miniprogram_dist/*"]
    }
  },
  "include": ["src", "config"]
}
