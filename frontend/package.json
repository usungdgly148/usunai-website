{
  "name": "coze-ai-app-prototype",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "gen:miniapp-preview": "node scripts/gen-miniapp-preview-style.mjs && node scripts/gen-official-markdown-style.mjs",
    "predev": "npm run gen:miniapp-preview",
    "dev": "vite",
    "prebuild": "npm run gen:miniapp-preview",
    "build": "vite build",
    "preview": "vite preview --host",
    "preview:opening-editor": "node scripts/preview-opening-editor.mjs",
    "check:web-markdown": "node scripts/check-web-opening-markdown.mjs && node scripts/check-web-markdown-render.mjs",
    "server": "node server/index.mjs"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "lucide-react": "^1.25.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0"
  }
}
